      "agent": "mike",
      "doc": "Kayıtlı bir beceriyi çalıştırır (adım dizisi: sabit komutlar, onaylı araçlar, ajan görevleri).",
      "needs_net": false,
      "effect": "write-chain",
      "args": {
        "name": {
          "type": "string",
          "required": true,
          "minLen": 2,
          "maxLen": 40
        },
        "input": {
          "type": "string",
          "required": false,
          "minLen": 1,
          "maxLen": 1000
        }
      }
