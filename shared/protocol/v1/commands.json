      "needs_net": false,
      "effect": "read",
      "args": {
        "day": {
          "type": "date",
          "default": "d+0"
        }
      }
    },
    "file.summarize": {
      "agent": "chloe",
      "doc": "Dosya özeti çıkarır. Çevrimdışıyken yerel özetleyici kullanılır.",
      "needs_net": false,
      "effect": "read",
      "args": {
        "uri": {
          "type": "uri",
          "required": true
