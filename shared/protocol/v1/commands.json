{
  "protocol": "orion",
  "v": 1,
  "doc": "Orion makine dili v1 komut seti. Tek doğruluk kaynağı: Kotlin ve Python doğrulayıcıları bu dosyayı okur.",
  "types": {
    "string": "UTF-8 metin; minLen/maxLen ile sınırlanır",
    "int": "tam sayı; min/max ile sınırlanır",
    "bool": "true/false",
    "enum": "values listesinden biri",
    "when": "zaman ifadesi; PROTOCOL.md 'when' dilbilgisi",
    "date": "YYYY-MM-DD veya d+N (bugünden N gün sonra)",
    "repo": "sahip/isim (GitHub)",
    "uri": "content:// veya file:// veya https:// adresi",
    "strlist": "metin listesi; maxItems ile sınırlanır"
  },
  "commands": {
    "reminder.set": {
      "agent": "emma",
      "doc": "Hatırlatıcı kurar.",
      "needs_net": false,
      "effect": "write-timed",
      "args": {
        "at": {
          "type": "when",
          "required": true
        },
        "text": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 200
        },
        "repeat": {
          "type": "enum",
          "values": [
            "none",
            "daily",
            "weekly"
          ],
          "default": "none"
        }
      }
    },
    "reminder.list": {
      "agent": "emma",
      "doc": "Bekleyen hatırlatıcıları listeler.",
      "needs_net": false,
      "effect": "read",
      "args": {}
    },
    "note.write": {
      "agent": "emma",
      "doc": "Not yazar. Gizli bilgi içeren not reddedilir (E_SECRET).",
      "needs_net": false,
      "effect": "write-easy",
      "args": {
        "text": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 2000
        },
        "tags": {
          "type": "strlist",
          "maxItems": 8,
          "itemMaxLen": 32
        }
      }
    },
    "note.search": {
      "agent": "emma",
      "doc": "Notlarda arar.",
      "needs_net": false,
      "effect": "read",
      "args": {
        "query": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 200
        },
        "limit": {
          "type": "int",
          "min": 1,
          "max": 50,
          "default": 10
        }
      }
    },
    "research.start": {
      "agent": "sophia",
      "doc": "Araştırma görevi başlatır. Bilgi gerektirir: sağlayıcıya araç çağrısı olarak gider.",
      "needs_net": true,
      "effect": "read",
      "args": {
        "topic": {
          "type": "string",
          "required": true,
          "minLen": 2,
          "maxLen": 300
        },
        "depth": {
          "type": "enum",
          "values": [
            "quick",
            "normal",
            "deep"
          ],
          "default": "normal"
        }
      }
    },
    "repo.audit": {
      "agent": "jack",
      "doc": "GitHub deposunu salt-okunur denetler (son commit, CI durumu, açık konular).",
      "needs_net": true,
      "effect": "read",
      "args": {
        "repo": {
          "type": "repo",
          "required": true
        },
        "scope": {
          "type": "enum",
          "values": [
            "summary",
            "ci",
            "security"
          ],
          "default": "summary"
        }
      }
    },
    "calendar.add": {
      "agent": "emma",
      "doc": "Takvime etkinlik ekler.",
      "needs_net": false,
      "effect": "write-timed",
      "args": {
        "title": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 200
        },
        "start": {
          "type": "when",
          "required": true
        },
        "minutes": {
          "type": "int",
          "min": 5,
          "max": 1440,
          "default": 60
        },
        "place": {
          "type": "string",
          "maxLen": 200
        }
      }
    },
    "calendar.list": {
      "agent": "emma",
      "doc": "Bir günün etkinliklerini listeler.",
      "needs_net": false,
      "effect": "read",
      "args": {
        "day": {
          "type": "date",
          "default": "d+0"
        }
      }
    },
    "file.summarize": {
      "agent": "chloe",
      "doc": "Dosya özeti çıkarır. Çevrimdışıyken yerel özetleyici kullanılır.",
      "needs_net": false,
      "effect": "read",
      "args": {
        "uri": {
          "type": "uri",
          "required": true
        },
        "length": {
          "type": "enum",
          "values": [
            "short",
            "medium",
            "long"
          ],
          "default": "short"
        }
      }
    },
    "image.analyze": {
      "agent": "jack",
      "doc": "Fotoğraf ya da ekran görüntüsünü okur (telefonda OCR), soruyu cevaplar ya da gördüğü sorunu çözmeye çalışır. İnternet yoksa kendi beyniyle çalışır.",
      "needs_net": false,
      "effect": "read",
      "args": {
        "uri": {
          "type": "uri",
          "required": true
        },
        "question": {
          "type": "string",
          "maxLen": 500
        }
      }
    },
    "image.generate": {
      "agent": "luna",
      "doc": "Tarife göre resim oluşturur (yardımcı sağlayıcı gerekir; anahtarsız seçenek: Pollinations).",
      "needs_net": true,
      "effect": "read",
      "args": {
        "prompt": {
          "type": "string",
          "required": true,
          "minLen": 2,
          "maxLen": 500
        },
        "size": {
          "type": "enum",
          "values": [
            "square",
            "portrait",
            "landscape"
          ],
          "default": "square"
        }
      }
    },
    "card.propose": {
      "agent": "luna",
      "doc": "Ana ekrana kart önerir. Yalnızca sabit 8 bileşen; serbest kod yok. Kullanıcı onaylar.",
      "needs_net": false,
      "effect": "proposal",
      "args": {
        "kind": {
          "type": "enum",
          "required": true,
          "values": [
            "note",
            "reminder",
            "chart",
            "research",
            "approval",
            "list",
            "timer",
            "metric"
          ]
        },
        "title": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 80
        },
        "source": {
          "type": "enum",
          "values": [
            "notes",
            "reminders",
            "calendar",
            "research",
            "quota",
            "manual"
          ],
          "default": "manual"
        },
        "refresh": {
          "type": "enum",
          "values": [
            "none",
            "hourly",
            "daily",
            "weekly"
          ],
          "default": "none"
        },
        "size": {
          "type": "enum",
          "values": [
            "half",
            "full"
          ],
          "default": "half"
        }
      }
    },
    "timer.start": {
      "agent": "emma",
      "doc": "Geri sayım başlatır.",
      "needs_net": false,
      "effect": "write-timed",
      "args": {
        "minutes": {
          "type": "int",
          "required": true,
          "min": 1,
          "max": 1440
        },
        "label": {
          "type": "string",
          "maxLen": 80
        }
      }
    },
    "provider.discover": {
      "agent": "sophia",
      "doc": "Yeni ücretsiz yapay zeka sağlayıcısı arar. Bulunanlar KAPALI ve 'doğrulanmadı' olarak öneri listesine düşer; kullanıcı onaylamadan kullanılmaz.",
      "needs_net": true,
      "effect": "read",
      "args": {
        "need": {
          "type": "string",
          "maxLen": 200
        }
      }
    },
    "health.check": {
      "agent": "emma",
      "doc": "Telefon sağlığı ön kontrolü (pil, boş alan, son yedek).",
      "needs_net": false,
      "effect": "read",
      "args": {
        "purpose": {
          "type": "enum",
          "values": [
            "general",
            "update"
          ],
          "default": "general"
        }
      }
    },
    "memory.save": {
      "agent": "emma",
      "doc": "Kalıcı hafızaya kayıt ÖNERİR; kullanıcı onayı olmadan kaydedilmez.",
      "needs_net": false,
      "effect": "proposal",
      "args": {
        "kind": {
          "type": "enum",
          "required": true,
          "values": [
            "note",
            "skill",
            "preference"
          ]
        },
        "text": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 2000
        }
      }
    },
    "ask": {
      "agent": "mike",
      "doc": "Genel soru-cevap ve sohbet. Önce Orion'un kendi beyni (telefondaki model), gerekirse yardımcılar. provider: kullanıcı belirli bir yardımcıyı istediyse (\"bunu Grok'a sor\") sağlayıcı kimliği (providers.json id); o yardımcı önce denenir, kullanılamıyorsa diğerlerine geçilir.",
      "needs_net": false,
      "effect": "read",
      "args": {
        "question": {
          "type": "string",
          "required": true,
          "minLen": 2,
          "maxLen": 1000
        },
        "provider": {
          "type": "string",
          "minLen": 2,
          "maxLen": 40
        }
      }
    },
    "calc.eval": {
      "agent": "chloe",
      "doc": "Hesap makinesi: dört işlem, üs, parantez, yüzde. İnternetsiz.",
      "needs_net": false,
      "effect": "read",
      "args": {
        "expr": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 200
        }
      }
    },
    "text.translate": {
      "agent": "emma",
      "doc": "Metni başka dile çevirir (önce kendi beyni).",
      "needs_net": false,
      "effect": "read",
      "args": {
        "text": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 2000
        },
        "to": {
          "type": "enum",
          "values": [
            "en",
            "tr",
            "de",
            "fr",
            "es",
            "ar",
            "ru",
            "it"
          ],
          "default": "en"
        }
      }
    },
    "market.crypto": {
      "agent": "ekbot",
      "doc": "Kripto para piyasası: genel durum (hacmi en büyük 10) ya da tek bir coinin fiyatı ve 24 saatlik değişimi. Binance Global herkese açık verisi (anahtarsız; EK BOT ile aynı kaynak).",
      "needs_net": true,
      "effect": "read",
      "args": {
        "coin": {
          "type": "string",
          "required": false,
          "minLen": 2,
          "maxLen": 40
        },
        "currency": {
          "type": "enum",
          "values": [
            "try",
            "usd",
            "eur"
          ],
          "default": "try"
        }
      }
    },
    "market.alert": {
      "agent": "ekbot",
      "doc": "Kripto fiyat alarmı: coin belirtilen fiyatın üstüne çıkınca (above) ya da altına inince (below) bildirim. Yön verilmezse kurulurken anlık fiyata göre seçilir. Fiyat arka planda Binance Global herkese açık verisinden yaklaşık 15 dakikada bir okunur; anlık değildir. Emir göndermez.",
      "needs_net": false,
      "effect": "write-timed",
      "args": {
        "coin": {
          "type": "string",
          "required": true,
          "minLen": 2,
          "maxLen": 40
        },
        "price": {
          "type": "int",
          "required": true,
          "min": 1,
          "max": 1000000000
        },
        "direction": {
          "type": "enum",
          "values": [
            "above",
            "below"
          ],
          "required": false
        },
        "currency": {
          "type": "enum",
          "values": [
            "usd",
            "try"
          ],
          "default": "usd"
        }
      }
    },
    "mail.check": {
      "agent": "emma",
      "doc": "Orion'a verilen e-posta hesabındaki son iletileri okur (kimden, konu, kısa özet). Hesap telefondaki kasada.",
      "needs_net": true,
      "effect": "read",
      "args": {
        "count": {
          "type": "int",
          "required": false,
          "min": 1,
          "max": 20,
          "default": 5
        },
        "unread": {
          "type": "bool",
          "required": false,
          "default": true
        },
        "query": {
          "type": "string",
          "required": false,
          "minLen": 2,
          "maxLen": 80
        }
      }
    },
    "mail.send": {
      "agent": "emma",
      "doc": "E-posta taslağı hazırlar; kullanıcı onaylamadan ASLA gönderilmez.",
      "needs_net": true,
      "effect": "proposal",
      "args": {
        "to": {
          "type": "string",
          "required": true,
          "minLen": 5,
          "maxLen": 200
        },
        "subject": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 200
        },
        "body": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 5000
        }
      }
    },
    "self.status": {
      "agent": "david",
      "doc": "Orion'un gelişim durumu: gelişim deposundaki yeni beyin sürümleri (komut, sohbet) ve uygulama güncellemesi; yeni sürüm varsa kurulum önerisi.",
      "needs_net": true,
      "effect": "read",
      "args": {}
    },
    "app.open": {
      "agent": "emma",
      "doc": "Telefondaki bir uygulamayı açar; bilinen uygulamalarda (YouTube, Spotify, Haritalar, Google, Play Store, GitHub, Vikipedi) içinde arama yapar. Gönderme/arama gibi son adımı kullanıcı yapar.",
      "needs_net": false,
      "effect": "read",
      "args": {
        "name": {
          "type": "string",
          "required": true,
          "minLen": 2,
          "maxLen": 40
        },
        "query": {
          "type": "string",
          "required": false,
          "minLen": 1,
          "maxLen": 200
        }
      }
    },
    "app.list": {
      "agent": "emma",
      "doc": "Telefonda kurulu uygulamaları listeler (Orion'un kullanabileceği araçlar).",
      "needs_net": false,
      "effect": "read",
      "args": {}
    },
