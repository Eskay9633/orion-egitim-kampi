      "effect": "write-timed",
      "args": {
        "title": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 200
        },
        "start": {
          "type": "when",
          "required": true
        },
        "minutes": {
          "type": "int",
          "min": 5,
          "max": 1440,
          "default": 60
