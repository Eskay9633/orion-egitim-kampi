      "needs_net": true,
      "effect": "read",
      "args": {
        "prompt": {
          "type": "string",
          "required": true,
          "minLen": 2,
          "maxLen": 500
        },
        "size": {
          "type": "enum",
          "values": [
            "square",
            "portrait",
            "landscape"
          ],
          "default": "square"
        }
      }
    },
    "card.propose": {
      "agent": "luna",
      "doc": "Ana ekrana kart önerir. Yalnızca sabit 8 bileşen; serbest kod yok. Kullanıcı onaylar.",
      "needs_net": false,
      "effect": "proposal",
      "args": {
        "kind": {
          "type": "enum",
          "required": true,
          "values": [
            "note",
            "reminder",
            "chart",
            "research",
            "approval",
            "list",
            "timer",
            "metric"
          ]
        },
        "title": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 80
        },
        "source": {
          "type": "enum",
          "values": [
            "notes",
            "reminders",
            "calendar",
            "research",
            "quota",
            "manual"
          ],
          "default": "manual"
        },
        "refresh": {
          "type": "enum",
          "values": [
            "none",
            "hourly",
            "daily",
            "weekly"
          ],
          "default": "none"
        },
        "size": {
          "type": "enum",
          "values": [
            "half",
            "full"
          ],
          "default": "half"
        }
      }
