{
  "protocol": "orion",
  "v": 1,
  "doc": "Orion makine dili v1 komut seti. Tek doğruluk kaynağı: Kotlin ve Python doğrulayıcıları bu dosyayı okur.",
  "types": {
    "string": "UTF-8 metin; minLen/maxLen ile sınırlanır",
    "int": "tam sayı; min/max ile sınırlanır",
    "bool": "true/false",
    "enum": "values listesinden biri",
    "when": "zaman ifadesi; PROTOCOL.md 'when' dilbilgisi",
    "date": "YYYY-MM-DD veya d+N (bugünden N gün sonra)",
    "repo": "sahip/isim (GitHub)",
    "uri": "content:// veya file:// veya https:// adresi",
    "strlist": "metin listesi; maxItems ile sınırlanır"
  },
  "commands": {
    "reminder.set": {
      "agent": "emma",
      "doc": "Hatırlatıcı kurar.",
      "needs_net": false,
      "effect": "write-timed",
      "args": {
        "at": {
          "type": "when",
          "required": true
        },
        "text": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 200
        },
        "repeat": {
          "type": "enum",
          "values": [
            "none",
            "daily",
            "weekly"
          ],
          "default": "none"
        }
      }
    },
    "reminder.list": {
      "agent": "emma",
      "doc": "Bekleyen hatırlatıcıları listeler.",
      "needs_net": false,
      "effect": "read",
      "args": {}
    },
    "note.write": {
      "agent": "emma",
      "doc": "Not yazar. Gizli bilgi içeren not reddedilir (E_SECRET).",
      "needs_net": false,
      "effect": "write-easy",
      "args": {
        "text": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 2000
        },
        "tags": {
          "type": "strlist",
          "maxItems": 8,
          "itemMaxLen": 32
        }
      }
    },
    "note.search": {
      "agent": "emma",
      "doc": "Notlarda arar.",
      "needs_net": false,
      "effect": "read",
      "args": {
        "query": {
          "type": "string",
          "required": true,
          "minLen": 1,
          "maxLen": 200
        },
        "limit": {
          "type": "int",
          "min": 1,
          "max": 50,
          "default": 10
        }
      }
    },
    "research.start": {
      "agent": "sophia",
      "doc": "Araştırma görevi başlatır. Bilgi gerektirir: sağlayıcıya araç çağrısı olarak gider.",
      "needs_net": true,
      "effect": "read",
      "args": {
        "topic": {
          "type": "string",
          "required": true,
          "minLen": 2,
          "maxLen": 300
        },
        "depth": {
          "type": "enum",
          "values": [
            "quick",
            "normal",
            "deep"
          ],
          "default": "normal"
        }
      }
    },
    "repo.audit": {
      "agent": "jack",
      "doc": "GitHub deposunu salt-okunur denetler (son commit, CI durumu, açık konular).",
      "needs_net": true,
      "effect": "read",
      "args": {
        "repo": {
          "type": "repo",
          "required": true
        },
        "scope": {
          "type": "enum",
          "values": [
            "summary",
            "ci",
            "security"
          ],
          "default": "summary"
        }
      }
    },
    "calendar.add": {
      "agent": "emma",
      "doc": "Takvime etkinlik ekler.",
