      "effect": "read",
      "args": {
        "question": {
          "type": "string",
          "required": true,
          "minLen": 2,
          "maxLen": 1000
        },
        "provider": {
          "type": "string",
          "minLen": 2,
          "maxLen": 40
        }
      }
    },
    "calc.eval": {
      "agent": "chloe",
      "doc": "Hesap makinesi: dört işlem, üs, parantez, yüzde. İnternetsiz.",
