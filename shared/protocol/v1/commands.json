    "timer.start": {
      "agent": "emma",
      "doc": "Geri sayım başlatır.",
      "needs_net": false,
      "effect": "write-timed",
      "args": {
        "minutes": {
          "type": "int",
          "required": true,
          "min": 1,
          "max": 1440
        },
        "label": {
          "type": "string",
          "maxLen": 80
        }
      }
